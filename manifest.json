{
    "name": "Kartmakare",
    "short_name": "Kartmakare",
    "lang": "en",
    "dir": "ltr",
    "categories": [
        "productivity",
        "business",
        "utilities"
    ],
    "description": "Make Wardley maps in three steps: list your components, sort each into an evolution stage, then arrange them on the map with links, areas and an anchor. Works offline, keeps every map on your device, and shares maps as a link or QR code.",
    "id": "/Kartmakare/",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#F5F5F5",
    "theme_color": "#5046e5",
    "handle_links": "preferred",
    "launch_handler": {
        "client_mode": "focus-existing"
    },
    "share_target": {
        "action": "./share-target",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "files",
                    "accept": [
                        "text/*",
                        "application/json",
                        ".txt",
                        ".md",
                        ".csv",
                        ".tsv",
                        ".log",
                        ".text",
                        ".json"
                    ]
                }
            ]
        }
    },
    "icons": [
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "kartmakare-icon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        },
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "screenshots": [
